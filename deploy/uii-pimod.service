[Unit]
Description=UII module agent — NH4MOD serial/PLC bridge + method engine
After=uii-hub.service
Wants=uii-hub.service

[Service]
Type=simple
WorkingDirectory=/opt/uii
EnvironmentFile=/etc/uii/pimod.env
ExecStart=/usr/bin/python3 -m uii_analyzer.pimod
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
